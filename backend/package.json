{
  "name": "kost48surabaya-v3-backend",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true}); fs.rmSync('tsconfig.build.tsbuildinfo',{force:true});\"",
    "start": "npm run prisma:generate && npx nest start",
    "start:dev": "npm run prisma:generate && npx nest start --watch",
    "start:debug": "npm run prisma:generate && npx nest start --debug --watch",
    "build": "npm run clean && npm run prisma:generate && npx tsc -p tsconfig.build.json && node -e \"const fs=require('fs');const p=require('path');const src='src/generated';const dst='dist/generated';if(fs.existsSync(src)){fs.cpSync(src,dst,{recursive:true})}\"",
    "build:local": "npm run build",
    "pretest:unit": "npm run build",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "golive": "node scripts/golive.mjs",
    "golive:setup": "npm run build && node scripts/golive-setup.js",
    "seed:owner": "node scripts/seed-owner.js",
    "seed:dev:reset": "node scripts/seed-dev-reset.js",
    "seed:dev:api": "node scripts/seed-dev-via-api.js",
    "seed:facilities": "node scripts/seed-facilities-inventory.js",
    "cpanel:setup": "npm ci && npm run build && npm prune --omit=dev",
    "cpanel:migrate": "prisma db push",
    "start:prod": "node --max-old-space-size=256 dist/main.js",
    "build:prod": "npm ci && npm run build",
    "install:prod": "npm ci --omit=dev",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
