  @@index([itemId])
  @@index([roomId])
  @@index([movementDate])
  @@index([movementType])
}


model StaffFieldReport {
  id                         Int                    @id @default(autoincrement())
  ticketId                   Int?
  roomId                     Int?
  roomItemId                 Int?
  inventoryItemId            Int?
  reportedByStaffId          Int
  reportedCondition          ReportedCondition
  conditionNotes             String?
