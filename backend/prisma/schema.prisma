model RenewRequest {
  id                     Int                @id @default(autoincrement())
  stayId                 Int
  tenantId               Int
  requestedTerm          PricingTerm
  requestedCheckOutDate  DateTime?          @db.Date
  status                 RenewRequestStatus @default(PENDING)
  requestNotes           String?
  reviewNotes            String?
  reviewedById           Int?
  reviewedAt             DateTime?
  // F2-1 (GAP #2) — owner-approved S-1, additive. DP 30% perpanjangan + grace H+7.
  downPaymentAmountRupiah Int?
  downPaymentPaidAt       DateTime?
  downPaymentDueDate      DateTime?         @db.Date // = hari-H (plannedCheckOutDate lama)
  settlementDueDate       DateTime?         @db.Date // = downPaymentPaidAt + 7 hari
  downPaymentInvoiceId    Int?                       // F2-1 inc.2b: invoice DP 30% terpisah (dibayar penuh sblm DP_SECURED)
  settlementInvoiceId     Int?                       // Invoice sisa sewa + utilitas; wajib PAID sebelum COMPLETED
  // F4-11: renewal/prabayar fleksibel kapan saja (additive S-3).
  prepaidMonths           Int?                       // jumlah bulan prabayar (>1 → unearned via F4-1)
  isEarly                 Boolean            @default(false) // diajukan lebih awal (bukan dekat akhir kontrak)
  // F4-13a: review/masukan tenant saat renewal → poin RENEWAL_REVIEW.
  tenantReview            String?
  tenantReviewAt          DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  stay       Stay   @relation(fields: [stayId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reviewedBy User?  @relation("RenewRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([stayId])
  @@index([tenantId])
  @@index([status, createdAt])
  @@index([settlementInvoiceId])
}

