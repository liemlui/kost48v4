  @@index([ledgerAlignmentJournalEntryId])
  @@index([acquisitionDate])
}

model AssetDepreciationRun {
  id                       Int                         @id @default(autoincrement())
  runNumber                String                      @unique
  periodYear               Int
  periodMonth              Int
  runDate                  DateTime                    @db.Date
  status                   AssetDepreciationRunStatus  @default(POSTED)
  totalDepreciationRupiah  Int                         @default(0)
  journalEntryId           Int?
  createdById              Int?
  postedAt                 DateTime?
  voidedAt                 DateTime?
  notes                    String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  journalEntry JournalEntry?              @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?                      @relation("AssetDepreciationRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        AssetDepreciationLine[]

  @@unique([periodYear, periodMonth])
  @@index([status])
  @@index([runDate])
  @@index([journalEntryId])
}

model AssetDepreciationLine {
  id                            Int      @id @default(autoincrement())
  runId                         Int
  fixedAssetId                  Int
  depreciationAmountRupiah      Int
  accumulatedBeforeRupiah       Int
  accumulatedAfterRupiah        Int
  bookValueBeforeRupiah         Int
  bookValueAfterRupiah          Int
  createdAt                     DateTime @default(now())

  run        AssetDepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fixedAsset FixedAsset           @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)

  @@unique([runId, fixedAssetId])
  @@index([fixedAssetId])
}

model AppNotification {
  id              Int       @id @default(autoincrement())
  recipientUserId Int
  title           String
  body            String
  linkTo          String?
  entityType      String?
  entityId        String?
  isRead          Boolean   @default(false)
  readAt          DateTime?

  // F4-2: outbox PWA Web Push (in-place). NONE = tak perlu push; PENDING = antre kirim;
  // SENT = sudah diproses (terkirim / tak ada device); FAILED = gagal final (lewat batas retry).
  pushStatus   PushDeliveryStatus @default(NONE)
  pushAttempts Int                @default(0)
  pushedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipientUser User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([pushStatus])
}

enum PushDeliveryStatus {
  NONE
  PENDING
  SENT
  FAILED
}

// F4-2: registrasi endpoint Web Push per browser/device (PushManager.subscribe).
model PushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  action      String
  entityType  String
  entityId    String?
  oldData     Json?
  newData     Json?
  meta        Json?
  createdAt   DateTime @default(now())

  actorUser User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// G9 (S-6): antrean draft AI lintas sesi. Additive; tidak mengganti AuditLog.
// resultJson HANYA berisi output AI (tanpa NIK penuh/foto KTP/bukti bayar mentah).
enum AiDraftStatus {
  DRAFT
  APPLIED
  REJECTED
  EXPIRED
}

model AiDraft {
  id           Int           @id @default(autoincrement())
  feature      String
  targetType   String?
  targetId     String?
  status       AiDraftStatus @default(DRAFT)
  mode         String
  model        String?
  snapshotHash String?
  promptHash   String?
  confidence   Float?
  resultJson   Json
  usageJson    Json?
  createdById  Int?
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNote   String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([feature, status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ChartOfAccount {
  id              Int                     @id @default(autoincrement())
  code            String                  @unique
  name            String
  type            AccountingAccountType
  normalBalance   AccountingNormalBalance
  description     String?
  parentId        Int?
  isSystemDefault Boolean                 @default(false)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  parent              ChartOfAccount?      @relation("ChartOfAccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            ChartOfAccount[]     @relation("ChartOfAccountHierarchy")
  cashAccounts        CashAccount[]
  openingBalanceLines OpeningBalanceLine[]
  journalLines        JournalLine[]
  fixedAssetAlignmentCredits FixedAsset[] @relation("FixedAssetAlignmentCreditAccount")

  @@index([type])
  @@index([normalBalance])
  @@index([parentId])
  @@index([isActive])
}

model CashAccount {
  id                    Int             @id @default(autoincrement())
  name                  String          @unique
  accountType           CashAccountType @default(BANK)
  chartOfAccountId      Int
  bankName              String?
  accountNumberMasked   String?
  holderName            String?
  openingBalanceRupiah  Int             @default(0)
  currentBalanceRupiah  Int             @default(0)
  isDefault             Boolean         @default(false)
  isActive              Boolean         @default(true)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  chartOfAccount ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)
  journalLines   JournalLine[]

  @@index([accountType])
  @@index([chartOfAccountId])
  @@index([isActive])
  @@index([isDefault])
}

model AccountingPeriod {
  id                    Int                    @id @default(autoincrement())
  year                  Int
  month                 Int
  startDate             DateTime               @db.Date
  endDate               DateTime               @db.Date
  status                AccountingPeriodStatus @default(OPEN)
  closedAt              DateTime?
  closedById            Int?
  closingJournalEntryId Int?
  closingNote           String?
  closeBasis            String?
  closeVersion          Int                    @default(0)
  reopenedAt            DateTime?
  reopenedById          Int?
  reopenJournalEntryId  Int?
  reopenReason          String?
  reopenVersion         Int                    @default(0)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  openingBalanceBatches OpeningBalanceBatch[]
  journalEntries        JournalEntry[]

  @@unique([year, month])
  @@index([status])
  @@index([startDate, endDate])
  @@index([closedById])
  @@index([closingJournalEntryId])
  @@index([reopenedById])
  @@index([reopenJournalEntryId])
}

model OpeningBalanceBatch {
  id                Int                       @id @default(autoincrement())
  batchNumber       String                    @unique
  accountingPeriodId Int?
  cutoverDate       DateTime                  @db.Date
  status            OpeningBalanceBatchStatus @default(DRAFT)
  notes             String?
  totalDebitRupiah  Int                       @default(0)
  totalCreditRupiah Int                       @default(0)
  createdById       Int?
  postedById        Int?
  postedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  accountingPeriod AccountingPeriod?    @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  lines            OpeningBalanceLine[]

  @@index([accountingPeriodId])
  @@index([cutoverDate])
  @@index([status])
}

model OpeningBalanceLine {
  id                Int      @id @default(autoincrement())
  batchId           Int
  chartOfAccountId  Int
  description       String?
  debitRupiah       Int      @default(0)
  creditRupiah      Int      @default(0)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  batch          OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chartOfAccount ChartOfAccount      @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([chartOfAccountId])
}

model JournalEntry {
  id                 Int                @id @default(autoincrement())
  entryNumber        String             @unique
  entryDate          DateTime           @db.Date
  accountingPeriodId Int?
  status             JournalEntryStatus @default(DRAFT)
  sourceType         JournalSourceType  @default(MANUAL)
  sourceId           String?
  memo               String?
  totalDebitRupiah   Int                @default(0)
  totalCreditRupiah  Int                @default(0)
  isBalanced         Boolean            @default(false)
  createdById        Int?
  postedById         Int?
  postedAt           DateTime?
  voidedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  accountingPeriod AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  lines            JournalLine[]
  depreciationRuns AssetDepreciationRun[]
  fixedAssetLedgerAlignments FixedAsset[] @relation("FixedAssetAlignmentJournalEntry")
  rentRecognitions RentRecognitionSchedule[]
  redemptions      Redemption[]

  @@index([entryDate])
  @@index([accountingPeriodId])
  @@index([status])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id               Int      @id @default(autoincrement())
  journalEntryId   Int
  chartOfAccountId Int
  cashAccountId    Int?
  description      String?
  debitRupiah      Int      @default(0)
  creditRupiah     Int      @default(0)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartOfAccount ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)
  cashAccount    CashAccount?   @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@index([journalEntryId])
  @@index([chartOfAccountId])
  @@index([cashAccountId])
}

// F4-1 (PSAK 72): jadwal pengakuan pendapatan sewa panjang (>1 bulan). Sewa ditangguhkan
// ke akun 2200 (Unearned Revenue) saat invoice diterbitkan, lalu diakui bertahap per
// bulan (DR 2200 / CR 4000). Satu baris = satu bulan; idempotent per (stayId, periodIndex).
model RentRecognitionSchedule {
  id                    Int       @id @default(autoincrement())
  stayId                Int
  periodIndex           Int
  periodStart           DateTime  @db.Date
  periodEnd             DateTime  @db.Date
  scheduledAmountRupiah Int
  recognizedAt          DateTime?
  journalEntryId        Int?
  createdAt             DateTime  @default(now())

  stay         Stay          @relation(fields: [stayId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([stayId, periodIndex])
  @@index([stayId])
  @@index([recognizedAt])
}

// F4-8 Pindah kamar resmi (E4). Stay SAMA dipertahankan (roomId diperbarui); deposit ikut
// apa adanya; harga dikunci kecuali override OWNER; meter kamar baru di-snapshot; kamar lama
// -> inspeksi. RoomTransfer = jejak audit perpindahan.
model RoomTransfer {
  id               Int      @id @default(autoincrement())
  stayId           Int
  fromRoomId       Int
  toRoomId         Int
  transferDate     DateTime @db.Date
  reason           String?
  rentBeforeRupiah Int
  rentAfterRupiah  Int
  note             String?
  createdById      Int?
  createdAt        DateTime @default(now())

  stay      Stay  @relation(fields: [stayId], references: [id], onDelete: Cascade)
  fromRoom  Room  @relation("RoomTransferFrom", fields: [fromRoomId], references: [id], onDelete: Restrict)
  toRoom    Room  @relation("RoomTransferTo", fields: [toRoomId], references: [id], onDelete: Restrict)
  createdBy User? @relation("RoomTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([stayId])
  @@index([fromRoomId])
  @@index([toRoomId])
}

// F4-9 Gamifikasi & Loyalitas tenant (dossier 19). Poin tak dapat dipindahtangankan;
// reward WAJIB terjurnal (M4); penukaran WAJIB approve admin/owner (M3).
enum LoyaltyPointReason {
  RENEWAL
  ON_TIME_PAYMENT
  VALIDATED_REPORT
  ONBOARDING_QUEST
  REDEMPTION
  ADJUSTMENT
}

enum LoyaltyRewardType {
  RENT_DISCOUNT
  SERVICE_ADDON
  METER_DISCOUNT
  BADGE
  PHYSICAL
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

// Ledger poin append-only (saldo = Σ delta). Idempotent per (sourceType, sourceId).
model LoyaltyPoint {
  id          Int                @id @default(autoincrement())
  tenantId    Int
  delta       Int
  reason      LoyaltyPointReason
  sourceType  String
  sourceId    String
  note        String?
  createdById Int?
  createdAt   DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([tenantId])
}

// Katalog reward (owner kelola).
model LoyaltyReward {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  pointCost   Int
  type        LoyaltyRewardType
  valueRupiah Int?
  isActive    Boolean           @default(true)
  stockQty    Int?
  // F4-13b: reward yang menukar poin jadi tugas staf (auto-create tiket saat FULFILLED).
  fulfillmentTaskCategory String?
  fulfillmentTaskTitle    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  redemptions Redemption[]

  @@index([isActive, type])
  @@index([pointCost])
}

// Penukaran reward (wajib approve; reward terjurnal saat FULFILLED).
model Redemption {
  id             Int              @id @default(autoincrement())
  tenantId       Int
  rewardId       Int
  pointCost      Int
  status         RedemptionStatus @default(PENDING)
  requestedAt    DateTime         @default(now())
  decidedAt      DateTime?
  decidedById    Int?
  journalEntryId Int?
  note           String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward       LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
}

// F4-13c (S-4): quest perbaikan sikap antar-tenant ANONIM. reporter dirahasiakan dari
// reportee; konfirmasi membaik oleh A atau admin; B dapat poin saat CONFIRMED.
enum PeerReportStatus {
  PENDING_REVIEW
  ACKNOWLEDGED
  IMPROVED
  CONFIRMED
  DISMISSED
}

model PeerBehaviorReport {
  id               Int              @id @default(autoincrement())
  reporterTenantId Int
  reporteeTenantId Int
  category         String
  description      String
  status           PeerReportStatus @default(PENDING_REVIEW)
  moderatedById    Int?
  acknowledgedAt   DateTime?
  improvedAt       DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reporter    Tenant @relation("PeerReportReporter", fields: [reporterTenantId], references: [id], onDelete: Cascade)
  reportee    Tenant @relation("PeerReportReportee", fields: [reporteeTenantId], references: [id], onDelete: Cascade)
  moderatedBy User?  @relation("PeerReportModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([reporteeTenantId, status])
  @@index([reporterTenantId])
  @@index([status])
}

// F4-13 (S-4): referral teman via KODE saat booking. Referrer dapat poin saat teman aktif.
enum ReferralStatus {
  PENDING
  JOINED
  REWARDED
  CANCELLED
}

model TenantReferral {
  id               Int            @id @default(autoincrement())
  referrerTenantId Int
  referredTenantId Int?           @unique
  status           ReferralStatus @default(PENDING)
  rewardedAt       DateTime?
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  referrer Tenant  @relation("ReferralReferrer", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referred Tenant? @relation("ReferralReferred", fields: [referredTenantId], references: [id], onDelete: SetNull)

  @@index([referrerTenantId])
  @@index([status])
}


model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  category  String   @default("Umum")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive, sortOrder])
}

// M-1: konstanta operasional yang bisa diatur owner (sumber tunggal).
// Singleton (selalu id = 1). Dipakai meter listrik/air (free kuota, tarif, toggle air).
model OperationalSetting {
  id                            Int      @id @default(1)
  freeElectricityKwhPerMonth    Int      @default(30)
  electricityTariffPerKwhRupiah Int      @default(2500)
  waterMeteringEnabled          Boolean  @default(false)
  waterTariffPerM3Rupiah        Int      @default(0)
  freeWaterM3PerMonth           Int      @default(0)
  // ── Konstanta layanan tambahan (owner-settable, dipakai booking/invoicing) ─
  wifiRupiah                    Int      @default(50000)   // WiFi per perangkat per bulan
  galonRupiah                   Int      @default(20000)   // Galon air Voila per galon
  petDepositRupiah              Int      @default(100000)  // Deposit jaminan hewan peliharaan (refundable)
  extraOccupantFeePercent       Int      @default(20)      // Biaya penghuni tambahan (% tarif/kepala/bulan)
  // ── AC cleaning (owner-settable): ambang estimasi kWh untuk pemicu DINI cuci AC ──
  acCleanKwhThreshold           Int      @default(200)     // kWh estimasi (watt×jam×hari) sejak cuci terakhir → buat tiket cuci AC (0 = matikan pemicu kWh)
  // ── R3: AI/DeepSeek owner-configurable settings ──────────────────────────
  deepseekModel                String   @default("deepseek-v4-flash")
  deepseekFinanceModel         String   @default("deepseek-v4-pro")
  deepseekBaseUrl              String   @default("https://api.deepseek.com")
  // API key DeepSeek — owner isi via Settings→AI (owner-request 2026-07-04); kosong = fallback env DEEPSEEK_API_KEY.
  // JANGAN pernah kirim nilai mentah kolom ini ke client — hanya status/preview (settings.service toSafeView).
  deepseekApiKey               String   @default("")
  aiFeaturesEnabled            Boolean  @default(false)
  aiManualOnly                 Boolean  @default(true)
  aiOwnerAdminOnly             Boolean  @default(true)
  aiDailyRequestLimit          Int      @default(50)
  aiMaxInputChars              Int      @default(12000)
  aiMaxOutputTokens            Int      @default(1400)
  aiFinanceMaxOutputTokens     Int      @default(2200)
  aiLogUsage                   Boolean  @default(true)
  aiDraftRetentionDays         Int      @default(60)
  capitalizationThresholdByCategory String? // JSON: {"SALARY":500000,...}
  // ── Fitur tenant toggle ──────────────────────────────────────────────────
  tenantLoyaltyEnabled          Boolean  @default(false)  // Loyalty/reward tenant (poin, leaderboard, katalog reward)
  ktpVerificationGateEnabled    Boolean  @default(false)  // F3-17: verifikasi KTP wajib sebelum check-in/booking (gate UU PDP)
  // ── Admin WhatsApp (owner-settable — D-25) ──────────────────────────────
  adminWhatsappNumber           String   @default("6285648887628")
  // ── Brevo Email (owner-settable) ────────────────────────────────────────
  brevoApiKey                   String   @default("")        // API key Brevo; kosong = nonaktifkan email (secret, never sent to client)
  mailFromEmail                 String   @default("no-reply@kost48surabaya.com")
  mailFromName                  String   @default("Kost48 Surabaya")
  // ── AutoOps Master Toggle ───────────────────────────────────────────────
  autoOpsEnabled                Boolean  @default(true)      // Master toggle semua AutoOps sweeps
  // ── Accounting Sweep Toggles ────────────────────────────────────────────
  recurringExpenseDraftsEnabled Boolean  @default(false)     // Recurring expense draft generation
  assetDepreciationAutoEnabled  Boolean  @default(false)     // Automatic asset depreciation
  rentRecognitionEnabled        Boolean  @default(false)     // PSAK 72 rent recognition
  notificationPruningEnabled    Boolean  @default(true)      // Old notification cleanup
  notificationRetentionDays     Int      @default(90)        // Days to retain notifications
  journalReconciliationEnabled  Boolean  @default(false)     // Auto journal backfill
  journalReconciliationLimit    Int      @default(100)       // Max journals per reconciliation run
  // ── AutoOps SLA Deadlines (jam) ─────────────────────────────────────────
  bookingReviewDeadlineHours           Int @default(3)   // Booking review deadline
  approvedBookingPaymentDeadlineHours  Int @default(3)   // Payment deadline after booking approved
  paymentReviewUrgentHours             Int @default(1)   // Payment review → urgent threshold
  paymentReviewEscalateHours           Int @default(3)   // Payment review escalation
  paymentReviewMaxHours                Int @default(6)   // Payment review max before forced action
  invoiceUrgentAfterHours              Int @default(6)   // Invoice overdue → urgent
  invoiceDueAfterHours                 Int @default(24)  // Invoice due horizon
  renewReminderDays                    Int @default(3)   // Days before checkout start renewal reminders
  renewLastCallHours                   Int @default(24)  // Renewal last-call window
  renewPaymentDeadlineHours            Int @default(3)   // Renewal payment deadline
  renewReviewUrgentHours               Int @default(3)   // Renewal review urgent
  renewReviewEscalateHours             Int @default(6)   // Renewal review escalate
  checkoutReviewUrgentHours            Int @default(3)   // Checkout review urgent
  checkoutReviewEscalateHours          Int @default(6)   // Checkout review escalate
  checkoutFinalUrgentHours             Int @default(6)   // Checkout final urgent window
  lateTenantVacateHours                Int @default(3)   // Late tenant vacate grace
  autoOpsIntervalMinutes               Int @default(5)   // AutoOps sweeper interval
  // ── Maintenance Toggle ──────────────────────────────────────────────────
  acCleaningEnabled             Boolean  @default(true)      // AC cleaning schedule enabled
  // ──────────────────────────────────────────────────────────────────────────
  updatedAt                     DateTime @updatedAt
  updatedById                   Int?
}

// PUB-LAYANAN-TAMBAHAN (additive, owner-approved 2026-06-18): daftar layanan
// tambahan (galon, TV, WiFi, dll) + tarif yang dikelola owner via Settings dan
// ditampilkan di portal tenant.
model AdditionalService {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  priceRupiah Int      @default(0)
  unit        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interests ServiceInterest[]

  @@index([isActive])
  @@index([sortOrder])
}

// PUB-LAYANAN-MINAT (additive, owner-approved 2026-06-18): tenant menyatakan minat
// atas layanan tambahan → admin proses (hubungi/selesai).
enum ServiceInterestStatus {
  PENDING
  CONTACTED
  DONE
  CANCELLED
}

// PUB-FOTO-PROFIL-KTP: asal foto profil tenant.
enum ProfilePhotoSource {
  KTP_AUTO // diturunkan otomatis dari foto KTP pertama
  MANUAL   // diunggah ulang owner/admin
}

model ServiceInterest {
  id        Int                   @id @default(autoincrement())
  serviceId Int
  tenantId  Int
  status    ServiceInterestStatus @default(PENDING)
  note      String?
  adminNote String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  service AdditionalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([tenantId])
  @@index([status])
}

// PUB-SURVEY: wizard preferensi calon penghuni — data marketing 1-5 tahun.
// Dicatat tanpa auth; dipakai analisa demografi & tren preferensi (generasi, harga, fasilitas).
model GuestPreferenceSurvey {
  id           String   @id @default(cuid())
  // Preferensi kamar
  bathroom     String?  // "inside" | "outside" | "any"
  cooling      String?  // "ac" | "fan" | "any"
  roomSize     String?  // "standard" | "large" | "any"
  roomType     String?  // "regular" | "mezzanine" | "any"
  // Prioritas (JSON array): ["cleanliness","security","price","location","facilities"]
  priorities   String?
  // Estimasi harga hasil simulator yang ditampilkan (Rupiah)
  estimatedPriceRupiah Int?
  // Apakah wizard di-skip
  skipped      Boolean  @default(false)
  // Metadata sesi (anonim)
  sessionId    String?
  userAgent    String?
  referrer     String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([bathroom, cooling, roomSize, roomType])
}

// Ulasan eksternal (Google Maps, dll) — tidak membutuhkan akun Tenant.
// Dipakai bersama StaffReview untuk social proof di halaman publik.
model ExternalReview {
  id          Int      @id @default(autoincrement())
  source      String   @default("google") // "google" | "facebook" | "manual"
  authorName  String
  rating      Int      // 1..5
  comment     String?
  isVisible   Boolean  @default(true)
  reviewedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([isVisible, rating])
  @@index([reviewedAt])
}
