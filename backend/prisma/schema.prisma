model FixedAsset {
  id                            Int                             @id @default(autoincrement())
  assetCode                     String                          @unique
  name                          String
  category                      FixedAssetCategory              @default(OTHER)
  status                        FixedAssetStatus                @default(ACTIVE)
  locationType                  FixedAssetLocationType          @default(GENERAL)
  capitalizationSource          FixedAssetCapitalizationSource  @default(DISCLOSURE_ONLY)
  depreciationMethod            FixedAssetDepreciationMethod    @default(STRAIGHT_LINE)
  acquisitionDate               DateTime                        @db.Date
  depreciationStartDate         DateTime?                       @db.Date
  acquisitionCostRupiah         Int
  salvageValueRupiah            Int                             @default(0)
  usefulLifeMonths              Int
  accumulatedDepreciationRupiah Int                             @default(0)
  depreciationEnabled           Boolean                         @default(false)
  roomId                        Int?
  inventoryItemId               Int?
  roomItemId                    Int?
  expenseId                     Int?
  createdById                   Int?
  ledgerAlignmentStatus         FixedAssetLedgerAlignmentStatus @default(NEEDS_REVIEW)
  ledgerAlignmentMethod         FixedAssetLedgerAlignmentMethod?
  ledgerAlignmentAmountRupiah   Int?
  ledgerAlignmentCreditAccountId Int?
  ledgerAlignmentJournalEntryId Int?
  ledgerAlignedAt               DateTime?
  ledgerAlignedById             Int?
  ledgerAlignmentNote           String?
  ledgerAlignmentReviewedAt     DateTime?
  ledgerAlignmentReviewedById   Int?
  notes                         String?
  disposedAt                    DateTime?                       @db.Date
  disposalNote                  String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt

  room             Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  inventoryItem    InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  roomItem         RoomItem?                @relation(fields: [roomItemId], references: [id], onDelete: SetNull)
  expense          Expense?                 @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdBy        User?                    @relation("FixedAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  ledgerAlignmentCreditAccount ChartOfAccount? @relation("FixedAssetAlignmentCreditAccount", fields: [ledgerAlignmentCreditAccountId], references: [id], onDelete: SetNull)
  ledgerAlignmentJournalEntry  JournalEntry?   @relation("FixedAssetAlignmentJournalEntry", fields: [ledgerAlignmentJournalEntryId], references: [id], onDelete: SetNull)
  depreciationLines AssetDepreciationLine[]

  @@index([status])
  @@index([category])
  @@index([locationType])
  @@index([capitalizationSource])
  @@index([depreciationEnabled])
  @@index([roomId])
  @@index([inventoryItemId])
  @@index([roomItemId])
  @@index([expenseId])
  @@index([ledgerAlignmentStatus])
  @@index([ledgerAlignmentMethod])
  @@index([ledgerAlignmentCreditAccountId])
  @@index([ledgerAlignmentJournalEntryId])
  @@index([acquisitionDate])
}

model AssetDepreciationRun {
