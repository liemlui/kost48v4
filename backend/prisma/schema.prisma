model User {
  id                Int       @id @default(autoincrement())
  fullName          String
  email             String    @unique
  passwordHash      String
  role              UserRole
  tenantId          Int?      @unique
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  // F4-14: info tip P2P staf (tenant tip langsung; TIDAK dijurnal/direkap di buku kos).
  tipGopay          String?
  tipOvo            String?
  tipDana           String?
  tipShopeepay      String?
  tipBank           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant                      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  announcementsCreated        Announcement[]       @relation("AnnouncementCreatedBy")
  staysCreated                Stay[]               @relation("StayCreatedBy")
  staysInitialMetersRecorded  Stay[]               @relation("StayInitialMetersRecordedBy")
  invoicesCreated             Invoice[]            @relation("InvoiceCreatedBy")
  paymentsCaptured            InvoicePayment[]     @relation("InvoicePaymentCapturedBy")
  ticketsAssigned             Ticket[]             @relation("TicketAssignedTo")
  staffRoutineTemplatesCreated StaffRoutineTemplate[] @relation("StaffRoutineTemplateCreatedBy")
  staffRoutineAssignments      StaffRoutineAssignment[] @relation("StaffRoutineAssignedTo")
  staffRoutineCompletions      StaffRoutineCompletion[] @relation("StaffRoutineCompletedBy")
  staffPerformanceEvents       StaffPerformanceEvent[]   @relation("StaffPerformanceEventStaff")
  staffPerformanceAudits       StaffWorkAudit[]          @relation("StaffWorkAuditStaff")
  staffPerformanceAuditsMade   StaffWorkAudit[]          @relation("StaffWorkAuditAuditor")
  staffReviewsReceived         StaffReview[]             @relation("StaffReviewStaff")
  staffReviewsModerated        StaffReview[]             @relation("StaffReviewModeratedBy")
  meterReadingsRecorded       MeterReading[]       @relation("MeterReadingRecordedBy")
  inventoryMovementsCreated   InventoryMovement[]  @relation("InventoryMovementCreatedBy")
  wifiSalesCreated            WifiSale[]           @relation("WifiSaleCreatedBy")
  expensesCreated             Expense[]            @relation("ExpenseCreatedBy")
  renewRequestsReviewed       RenewRequest[]       @relation("RenewRequestReviewedBy")
  checkoutRequestsReviewed    CheckoutRequest[]    @relation("CheckoutRequestReviewedBy")
  auditLogs                   AuditLog[]           @relation("AuditLogActor")
  paymentSubmissionsSubmitted PaymentSubmission[]  @relation("PaymentSubmissionSubmittedBy")
  paymentSubmissionsReviewed  PaymentSubmission[]  @relation("PaymentSubmissionReviewedBy")
  passwordResetTokens         PasswordResetToken[]
  notifications               AppNotification[]
  pushSubscriptions           PushSubscription[]
  staffFieldReportsCreated    StaffFieldReport[] @relation("StaffFieldReportCreatedBy")
  staffFieldReportsReviewed   StaffFieldReport[] @relation("StaffFieldReportReviewedBy")
  fixedAssetsCreated          FixedAsset[] @relation("FixedAssetCreatedBy")
  assetDepreciationRunsCreated AssetDepreciationRun[] @relation("AssetDepreciationRunCreatedBy")
  depositLedgerEntriesActed TenantDepositLedgerEntry[] @relation("DepositLedgerActor")
  staysFledMarked           Stay[]                     @relation("StayFledMarkedBy")
  tenantsKtpVerified        Tenant[]                   @relation("TenantKtpVerifiedBy")
  roomTransfersCreated      RoomTransfer[]             @relation("RoomTransferCreatedBy")
  peerReportsModerated      PeerBehaviorReport[]       @relation("PeerReportModeratedBy")
  marketAnalysesCreated     MarketAnalysis[]           @relation("MarketAnalysisCreatedBy")
  satisfactionSurveysCreated SatisfactionSurvey[]
  refreshTokens             RefreshToken[]

  @@index([role])
  @@index([isActive])
}

// Marketing/strategi (owner): analisa pasar (SWOT/PESTLE/kompetitor) hasil chat AI DeepSeek
// — disusun lewat wawancara AI ke owner + pengetahuan pasar; transcript & hasil terstruktur disimpan.
// (Riset web LIVE = fase lanjutan; lihat docs.)
// P3-01: Refresh token for secure auth — stored as SHA-256 hash, supports revocation.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique // SHA-256 hash of the raw refresh token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model MarketAnalysis {
  id             Int      @id @default(autoincrement())
  kind           String   // SWOT | PESTLE | COMPETITOR | OTHER
  title          String
  summary        String?
  resultJson     Json? // hasil terstruktur (mis. { strengths:[], weaknesses:[], ... })
  transcriptJson Json? // [{ role, content }] riwayat chat
  createdById    Int?
  createdBy      User?    @relation("MarketAnalysisCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([kind, createdAt])
}

// Survei kepuasan penghuni (marketing/insight): rating keseluruhan + aspek + rekomendasi + komentar.
// Scalar-only (tanpa relation) agar ringan; dipakai untuk ringkasan owner & konteks analisa SWOT.
model SatisfactionSurvey {
  id             Int      @id @default(autoincrement())
  tenantId       Int?     
  stayId         Int?     
  overallRating  Int // 1..5
  cleanliness    Int?
  staffService   Int?
  facility       Int?
  valueForMoney  Int?
  wouldRecommend Boolean?
  comment        String?
  createdById    Int?
  createdAt      DateTime @default(now())

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  stay      Stay?   @relation(fields: [stayId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Tenant {
  id             Int     @id @default(autoincrement())
  fullName       String
  phone          String
  email          String?
  identityNumber String?  @unique

  // F3-17: foto KTP terproteksi + jejak verifikasi + hapus saat keluar (UU PDP).
  ktpImageUrl              String?
  ktpImageFileKey          String?
  ktpImageOriginalFilename String?
  ktpImageMimeType         String?
  ktpImageFileSizeBytes    Int?
  ktpVerifiedAt            DateTime?
  ktpVerifiedById          Int?
  // G5+: metadata verifikasi KTP — metode (AI / AI_FAILED_MANUAL / MANUAL) + catatan admin.
  ktpVerificationMethod    String?
  ktpVerificationNotes     String?
  ktpDeletedAt             DateTime?

  // PUB-FOTO-PROFIL-KTP: foto profil/avatar tenant. Default diturunkan dari foto KTP
  // pertama (source KTP_AUTO); owner/admin bisa ganti (source MANUAL). KTP_AUTO ikut
  // terhapus saat KTP dihapus (UU PDP); MANUAL tetap karena foto terpisah dari KTP.
  profilePhotoUrl           String?
  profilePhotoFileKey       String?
  profilePhotoMimeType      String?
  profilePhotoFileSizeBytes Int?
  profilePhotoSource        ProfilePhotoSource?
  profilePhotoUpdatedAt     DateTime?

  gender          Gender?
  birthDate       DateTime?
  originCity      String?
  originProvince  String?
  occupation      String?
  companyOrCampus String?

  emergencyContactName  String?
  emergencyContactPhone String?

  // Marketing analytics — opsional, self-reported, bebas diedit kapan saja
  maritalStatus    MaritalStatus?
  vehicleOwnership VehicleOwnership?
  smokingHabit     SmokingHabit?
  howDidYouHear    LeadSource?

  notes     String?
  isActive  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user               User?
  ktpVerifiedBy      User? @relation("TenantKtpVerifiedBy", fields: [ktpVerifiedById], references: [id], onDelete: SetNull)
  stays              Stay[]
  tickets            Ticket[]
  paymentSubmissions PaymentSubmission[]
  renewRequests      RenewRequest[]
  staffReviews       StaffReview[]
  depositLedgerEntries TenantDepositLedgerEntry[]
  loyaltyPoints      LoyaltyPoint[]
  redemptions        Redemption[]
  serviceInterests   ServiceInterest[]
  // F4-13/S-4: referral + quest perbaikan sikap.
  referralCode        String?              @unique
  referralsMade       TenantReferral[]     @relation("ReferralReferrer")
  referredReferral    TenantReferral?      @relation("ReferralReferred")
  peerReportsMade     PeerBehaviorReport[] @relation("PeerReportReporter")
  peerReportsReceived PeerBehaviorReport[] @relation("PeerReportReportee")
  satisfactionSurveys SatisfactionSurvey[]

  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@index([gender])
  @@index([originCity])
  @@index([occupation])
  @@index([companyOrCampus])
  @@index([isActive])
  @@index([maritalStatus])
  @@index([vehicleOwnership])
  @@index([howDidYouHear])
}

model Room {
  id     Int        @id @default(autoincrement())
  code   String     @unique
  name   String?
  floor  String?
  status RoomStatus @default(AVAILABLE)

  // PUB-ROOM-CATEGORY (additive): kategori & tipe & ukuran untuk katalog publik.
  category RoomCategory @default(STANDARD)
  roomType RoomType     @default(REGULAR)
  roomSize RoomSize     @default(STANDARD)

  dailyRateRupiah    Int?
  weeklyRateRupiah   Int?
  biWeeklyRateRupiah Int?
  monthlyRateRupiah  Int

  defaultDepositRupiah          Int @default(0)
  electricityTariffPerKwhRupiah Int @default(0)
  waterTariffPerM3Rupiah        Int @default(0)

  images    String[] @default([])
  notes     String?
  isActive  Boolean  @default(true)

  // Kamar bekas overstay/forced-checkout: masih MAINTENANCE (kotor, dibersihkan
  // staf) tetapi sudah boleh DIPESAN (booking + DP); aktivasi/huni menunggu
  // tiket pembersihan ditutup. Keputusan owner 2026-06-11.
  allowBookingWhileCleaning Boolean @default(false)

  // F4-15: penjadwalan cuci AC berbasis pemakaian listrik (additive S-3).
  hasAc               Boolean   @default(false)
  acWattage           Int?      // watt AC (1/2 PK ~ 380-450)
  acLastCleanedAt     DateTime?
  acCleanIntervalDays Int       @default(90)
  // AUD-3 (S-5): estimasi jam pakai AC per hari → kWh = watt × jam/hari (alert dini hibrid). null → default konstanta.
  acUsageHoursPerDay  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stays              Stay[]
  meterReadings      MeterReading[]
  tickets            Ticket[]
  roomItems          RoomItem[]
  transfersFrom      RoomTransfer[] @relation("RoomTransferFrom")
  transfersTo        RoomTransfer[] @relation("RoomTransferTo")
  staffRoutineAssignments StaffRoutineAssignment[] @relation("StaffRoutineAssignmentRoom")
  staffRoutineCompletions StaffRoutineCompletion[] @relation("StaffRoutineCompletionRoom")
  expenses           Expense[]
  inventoryMovements InventoryMovement[]
  staffFieldReports  StaffFieldReport[]
  facilities         RoomFacility[]
  fixedAssets        FixedAsset[]
  depositLedgerEntries TenantDepositLedgerEntry[]

  @@index([status])
  @@index([isActive])
  @@index([floor, category])
  @@index([category, roomType, roomSize])
}

model RoomFacility {
  id              Int      @id @default(autoincrement())
  roomId          Int
  name            String
  quantity        Int      @default(1)
  category        String?
  publicVisible   Boolean  @default(true)
  condition       String?
  note            String?
  // STF-GUDANG-2: mapping eksak fasilitas → item gudang (minQty dinamis).
  inventoryItemId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  room          Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([roomId, publicVisible])
  @@index([inventoryItemId])
}

model Stay {
  id       Int        @id @default(autoincrement())
  tenantId Int
  roomId   Int
  status   StayStatus @default(ACTIVE)

  pricingTerm            PricingTerm
  agreedRentAmountRupiah Int
  occupantCount          Int         @default(1) // jumlah penghuni; melebihi batas gratis per roomSize → +20%/orang
  hasPet                 Boolean     @default(false) // ada hewan peliharaan → petDepositRupiah dibebankan

  checkInDate         DateTime  @db.Date
  plannedCheckOutDate DateTime? @db.Date
  actualCheckOutDate  DateTime? @db.Date
  expiresAt           DateTime?

  depositAmountRupiah     Int                         @default(0)
  depositPaidAmountRupiah Int                         @default(0)
  depositPaymentStatus    BookingDepositPaymentStatus @default(UNPAID)
  depositStatus           DepositStatus               @default(HELD)
  depositDeductionRupiah  Int                         @default(0)
  depositRefundedRupiah   Int                         @default(0)
  depositRefundedAt       DateTime?
  depositNote             String?

  // DP (uang muka pesan kamar, bagian harga sewa, non-refundable, hangus bila
  // gagal lunas) — BERBEDA dari deposit* di atas (uang jaminan, dicek saat
  // checkout, refundable). Ketetapan owner 2026-06-11, audit A18.
  downPaymentAmountRupiah Int       @default(0)
  downPaymentPaidRupiah   Int       @default(0)
  downPaymentPaidAt       DateTime?
  downPaymentForfeitedAt  DateTime?

  // F2-3b: refund tenant yang KALAH first-paid-wins padahal sudah transfer (BEDA dari
  // deposit refund jaminan & DP forfeit). Auto-set PENDING saat booking loser dibatalkan;
  // OWNER memproses + unggah bukti transfer balik → COMPLETED.
  lossRefundStatus        RefundStatus @default(NONE)
  lossRefundAmountRupiah  Int          @default(0)
  lossRefundProofUrl      String?
  lossRefundProofFileKey  String?
  lossRefundNote          String?
  lossRefundProcessedAt   DateTime?
  lossRefundProcessedById Int?

  electricityTariffPerKwhRupiah Int @default(0)
  waterTariffPerM3Rupiah        Int @default(0)

  bookingSource       LeadSource?
  bookingSourceDetail String?
  stayPurpose         StayPurpose?
  checkoutReason      String?
  cancelReason        String?

  // F3-14/F3-16: penandaan "kabur" + jejak forced-checkout admin.
  fledMarkedAt   DateTime?
  fledMarkedById Int?
  fledReason     String?

  // F3-15: pelacakan barang tenant pasca-checkout (abandoned 30 hari).
  belongingsStatus     BelongingsStatus @default(PENDING)
  belongingsDeadline   DateTime?
  belongingsResolvedAt DateTime?

  notes       String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initialElectricityKwhPending Decimal?   @db.Decimal(12, 3)
  initialWaterM3Pending        Decimal?   @db.Decimal(12, 3)
  initialMetersRecordedAt      DateTime?
  initialMetersRecordedById    Int?
  initialMetersPromotedAt      DateTime?

  tenant                  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  room                    Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy               User?  @relation("StayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  initialMetersRecordedBy User?  @relation("StayInitialMetersRecordedBy", fields: [initialMetersRecordedById], references: [id], onDelete: SetNull)
  fledMarkedBy            User?  @relation("StayFledMarkedBy", fields: [fledMarkedById], references: [id], onDelete: SetNull)

  invoices           Invoice[]
  tickets            Ticket[]
  expenses           Expense[]
  paymentSubmissions PaymentSubmission[]
  renewRequests      RenewRequest[]
  checkoutRequests   CheckoutRequest[]
  depositLedgerEntries TenantDepositLedgerEntry[]
  rentRecognitionSchedules RentRecognitionSchedule[]
