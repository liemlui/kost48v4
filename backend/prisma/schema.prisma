generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  TENANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum PricingTerm {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  SMESTERLY
  YEARLY
}

enum StayStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DepositStatus {
  HELD
  PARTIALLY_REFUNDED
  REFUNDED
  FORFEITED
}

enum UtilityType {
  ELECTRICITY
  WATER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

enum InvoiceLineType {
  RENT
  ELECTRICITY
  WATER
  PENALTY
  DISCOUNT
  WIFI
  OTHER
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  EWALLET
  OTHER
}

enum PaymentSubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentSubmissionTargetType {
  INVOICE
  DEPOSIT
}

enum BookingDepositPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TenantDepositLedgerEntryType {
  CHARGED
  PAYMENT_RECEIVED
  HELD
  REFUND
  DEDUCTION
  FORFEIT
  SETTLEMENT
  ADJUSTMENT
  MIGRATION_SNAPSHOT
}

enum TenantDepositLedgerDirection {
  INCREASE_LIABILITY
  DECREASE_LIABILITY
  INFO
}

enum RenewRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // F2-1 (GAP #2) state machine renewal DP penuh — owner-approved S-1 (2026-06-13, additive).
  PENDING_DECISION   // H-10..H-day: tenant ditanya perpanjang?
  AWAITING_DP        // tenant jawab YA → tunggu DP 30% (prioritas s/d hari-H)
  DP_SECURED         // DP 30% diterima ≤ hari-H → kamar aman, tunggu pelunasan ≤ H+7
  COMPLETED          // pelunasan ≤ H+7 → stay diperpanjang (renewStayInTransaction)
  REJECTED_BY_TENANT // tenant jawab TIDAK → kamar dibuka publik
  EXPIRED_PRIORITY   // hari-H lewat tanpa DP → prioritas hilang, kamar dibuka first-paid
  FORFEITED          // gagal lunas H+7 → forced checkout + DP hangus + potong deposit
}

enum CheckoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
  CLOSED
  CANCELLED
}

enum RoomItemStatus {
  GOOD
  DAMAGED
  MAINTENANCE
  MISSING
}

enum InventoryItemStatus {
  GOOD
  LOW_STOCK
  OUT_OF_STOCK
  DAMAGED
  MISSING
  NEEDS_REPAIR
  PENDING_CHECK
}

enum ReportedCondition {
  DAMAGED
  MISSING
  NEEDS_REPAIR
  NEEDS_REPLACEMENT
  NEEDS_CLEANING
  LOW_STOCK
  OUT_OF_STOCK
  PENDING_CHECK
}

enum AdminDecision {
  APPROVE
  REJECT
  NEEDS_MORE_INFO
}

enum StaffFieldReportStatus {
  REPORTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_REPAIR
  DONE
  CLOSED
}

enum InventoryMovementType {
  IN
  OUT
  ASSIGN_TO_ROOM
  RETURN_FROM_ROOM
  ADJUSTMENT
}

enum StaffRoutineFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum StaffRoutineAreaType {
  GENERAL
  BATHROOM
  ROOM
  INVENTORY
  METER
  SECURITY
  CLEANING
}

enum StaffRoutineStatus {
  IN_PROGRESS
  DONE
  NEED_HELP
  MISSED
  SKIPPED
}

enum StaffWorkSourceType {
  ROUTINE
  TICKET
  METER
  ROOM_CHECK
  STOCK_REPORT
  INVENTORY_REPORT
  TENANT_REVIEW
  MANUAL_AUDIT
}

enum StaffAuditResult {
  PASS
  NEEDS_FIX
  FAILED
  NOT_DONE
}

enum StaffReviewStatus {
  VISIBLE
  HIDDEN
  FLAGGED
  PENDING_VERIFICATION // F2-18: review tenant menunggu verifikasi owner sebelum tampil (workflow menyusul)
}

enum StaffPerformanceEventType {
  ROUTINE_DONE
  ROUTINE_NEED_HELP
  TICKET_DONE
  METER_RECORDED
  STOCK_REPORTED
  AUDIT_PASS
  AUDIT_NEEDS_FIX
  AUDIT_FAILED
  TENANT_REVIEW_HIGH
  TENANT_REVIEW_LOW
  MISSING_PROOF
  MANUAL_ADJUSTMENT
}

enum AnnouncementAudience {
  TENANT
  ALL
}

enum LeadSource {
  GOOGLE_MAPS
  WALK_IN
  REFERRAL
  INSTAGRAM
  TIKTOK
  WHATSAPP
  FACEBOOK
  WEBSITE
  OTA
  OTHER
}

enum StayPurpose {
  WORK
  STUDY
  TRANSIT
  FAMILY
  MEDICAL
  PROJECT
  OTHER
}

enum ExpenseType {
  FIXED
  VARIABLE
}

enum ExpenseCategory {
  RENT_BUILDING
  SALARY
  ELECTRICITY
  WATER
  INTERNET
  MAINTENANCE
  CLEANING
  SUPPLIES
  TAX
  MARKETING
  OTHER
}


enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
}

enum AccountingNormalBalance {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum CashAccountType {
  CASH
  BANK
  QRIS
  EWALLET
  OTHER
}

enum OpeningBalanceBatchStatus {
  DRAFT
  POSTED
  VOID
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum JournalSourceType {
  MANUAL
  OPENING_BALANCE
  SYSTEM_PLACEHOLDER
  INVOICE
  INVOICE_PAYMENT
  PAYMENT_SUBMISSION
  EXPENSE
  WIFI_SALE
  DEPOSIT
  INVENTORY
  DEPRECIATION
  ADJUSTMENT
  CLOSING_ENTRY
  CLOSING_REVERSAL
}


enum FixedAssetCategory {
  BUILDING
  RENOVATION
  ROOM_EQUIPMENT
  FURNITURE
  ELECTRONIC
  UTILITY_EQUIPMENT
  VEHICLE
  SOFTWARE
  OTHER
}

enum FixedAssetStatus {
  DRAFT
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
  WRITTEN_OFF
}

enum FixedAssetLocationType {
  GENERAL
  ROOM
  WAREHOUSE
}

enum FixedAssetCapitalizationSource {
  OPENING_BALANCE
  PURCHASE_JOURNAL
  DISCLOSURE_ONLY
}

enum FixedAssetDepreciationMethod {
  STRAIGHT_LINE
}

enum FixedAssetLedgerAlignmentStatus {
  NOT_REQUIRED
  NEEDS_REVIEW
  PREVIEWED
  ALIGNED
  DISCLOSURE_ONLY
  VOIDED
}

enum FixedAssetLedgerAlignmentMethod {
  RECLASSIFY_FROM_CASH
  OWNER_CAPITAL_CONTRIBUTION
  DISCLOSURE_ONLY
  MANUAL_REVIEW
}

enum AssetDepreciationRunStatus {
  POSTED
  VOID
}

model User {
  id                Int       @id @default(autoincrement())
  fullName          String
  email             String    @unique
  passwordHash      String
  role              UserRole
  tenantId          Int?      @unique
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant                      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  announcementsCreated        Announcement[]       @relation("AnnouncementCreatedBy")
  staysCreated                Stay[]               @relation("StayCreatedBy")
  staysInitialMetersRecorded  Stay[]               @relation("StayInitialMetersRecordedBy")
  invoicesCreated             Invoice[]            @relation("InvoiceCreatedBy")
  paymentsCaptured            InvoicePayment[]     @relation("InvoicePaymentCapturedBy")
  ticketsAssigned             Ticket[]             @relation("TicketAssignedTo")
  staffRoutineTemplatesCreated StaffRoutineTemplate[] @relation("StaffRoutineTemplateCreatedBy")
  staffRoutineAssignments      StaffRoutineAssignment[] @relation("StaffRoutineAssignedTo")
  staffRoutineCompletions      StaffRoutineCompletion[] @relation("StaffRoutineCompletedBy")
  staffPerformanceEvents       StaffPerformanceEvent[]   @relation("StaffPerformanceEventStaff")
  staffPerformanceAudits       StaffWorkAudit[]          @relation("StaffWorkAuditStaff")
  staffPerformanceAuditsMade   StaffWorkAudit[]          @relation("StaffWorkAuditAuditor")
  staffReviewsReceived         StaffReview[]             @relation("StaffReviewStaff")
  staffReviewsModerated        StaffReview[]             @relation("StaffReviewModeratedBy")
  meterReadingsRecorded       MeterReading[]       @relation("MeterReadingRecordedBy")
  inventoryMovementsCreated   InventoryMovement[]  @relation("InventoryMovementCreatedBy")
  wifiSalesCreated            WifiSale[]           @relation("WifiSaleCreatedBy")
  expensesCreated             Expense[]            @relation("ExpenseCreatedBy")
  renewRequestsReviewed       RenewRequest[]       @relation("RenewRequestReviewedBy")
  checkoutRequestsReviewed    CheckoutRequest[]    @relation("CheckoutRequestReviewedBy")
  auditLogs                   AuditLog[]           @relation("AuditLogActor")
  paymentSubmissionsSubmitted PaymentSubmission[]  @relation("PaymentSubmissionSubmittedBy")
  paymentSubmissionsReviewed  PaymentSubmission[]  @relation("PaymentSubmissionReviewedBy")
  passwordResetTokens         PasswordResetToken[]
  notifications               AppNotification[]
  staffFieldReportsCreated    StaffFieldReport[] @relation("StaffFieldReportCreatedBy")
  staffFieldReportsReviewed   StaffFieldReport[] @relation("StaffFieldReportReviewedBy")
  fixedAssetsCreated          FixedAsset[] @relation("FixedAssetCreatedBy")
  assetDepreciationRunsCreated AssetDepreciationRun[] @relation("AssetDepreciationRunCreatedBy")
  depositLedgerEntriesActed TenantDepositLedgerEntry[] @relation("DepositLedgerActor")

  @@index([role])
  @@index([isActive])
}

model Tenant {
  id             Int     @id @default(autoincrement())
  fullName       String
  phone          String
  email          String?
  identityNumber String?

  gender          Gender?
  birthDate       DateTime?
  originCity      String?
  occupation      String?
  companyOrCampus String?

  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user               User?
  stays              Stay[]
  tickets            Ticket[]
  paymentSubmissions PaymentSubmission[]
  renewRequests      RenewRequest[]
  staffReviews       StaffReview[]
  depositLedgerEntries TenantDepositLedgerEntry[]

  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@index([gender])
  @@index([originCity])
  @@index([occupation])
  @@index([companyOrCampus])
  @@index([isActive])
}

model Room {
  id     Int        @id @default(autoincrement())
  code   String     @unique
  name   String?
  floor  String?
  status RoomStatus @default(AVAILABLE)

  dailyRateRupiah    Int?
  weeklyRateRupiah   Int?
  biWeeklyRateRupiah Int?
  monthlyRateRupiah  Int

  defaultDepositRupiah          Int @default(0)
  electricityTariffPerKwhRupiah Int @default(0)
  waterTariffPerM3Rupiah        Int @default(0)

  images    String[] @default([])
  notes     String?
  isActive  Boolean  @default(true)

  // Kamar bekas overstay/forced-checkout: masih MAINTENANCE (kotor, dibersihkan
  // staf) tetapi sudah boleh DIPESAN (booking + DP); aktivasi/huni menunggu
  // tiket pembersihan ditutup. Keputusan owner 2026-06-11.
  allowBookingWhileCleaning Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stays              Stay[]
  meterReadings      MeterReading[]
  tickets            Ticket[]
  roomItems          RoomItem[]
  staffRoutineAssignments StaffRoutineAssignment[] @relation("StaffRoutineAssignmentRoom")
  staffRoutineCompletions StaffRoutineCompletion[] @relation("StaffRoutineCompletionRoom")
  expenses           Expense[]
  inventoryMovements InventoryMovement[]
  staffFieldReports  StaffFieldReport[]
  facilities         RoomFacility[]
  fixedAssets        FixedAsset[]
  depositLedgerEntries TenantDepositLedgerEntry[]

  @@index([status])
  @@index([isActive])
}

model RoomFacility {
  id        Int      @id @default(autoincrement())
  roomId    Int
  name      String
  quantity  Int      @default(1)
  category  String?
  publicVisible  Boolean  @default(true)
  condition String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([roomId, publicVisible])
}

model Stay {
  id       Int        @id @default(autoincrement())
  tenantId Int
  roomId   Int
  status   StayStatus @default(ACTIVE)

  pricingTerm            PricingTerm
  agreedRentAmountRupiah Int

  checkInDate         DateTime  @db.Date
  plannedCheckOutDate DateTime? @db.Date
  actualCheckOutDate  DateTime? @db.Date
  expiresAt           DateTime?

  depositAmountRupiah     Int                         @default(0)
  depositPaidAmountRupiah Int                         @default(0)
  depositPaymentStatus    BookingDepositPaymentStatus @default(UNPAID)
  depositStatus           DepositStatus               @default(HELD)
  depositDeductionRupiah  Int                         @default(0)
  depositRefundedRupiah   Int                         @default(0)
  depositRefundedAt       DateTime?
  depositNote             String?

  // DP (uang muka pesan kamar, bagian harga sewa, non-refundable, hangus bila
  // gagal lunas) — BERBEDA dari deposit* di atas (uang jaminan, dicek saat
  // checkout, refundable). Ketetapan owner 2026-06-11, audit A18.
  downPaymentAmountRupiah Int       @default(0)
  downPaymentPaidRupiah   Int       @default(0)
  downPaymentPaidAt       DateTime?
  downPaymentForfeitedAt  DateTime?

  electricityTariffPerKwhRupiah Int @default(0)
  waterTariffPerM3Rupiah        Int @default(0)

  bookingSource       LeadSource?
  bookingSourceDetail String?
  stayPurpose         StayPurpose?
  checkoutReason      String?
  cancelReason        String?

  notes       String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initialElectricityKwhPending Decimal?   @db.Decimal(12, 3)
  initialWaterM3Pending        Decimal?   @db.Decimal(12, 3)
  initialMetersRecordedAt      DateTime?
  initialMetersRecordedById    Int?
  initialMetersPromotedAt      DateTime?

  tenant                  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  room                    Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy               User?  @relation("StayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  initialMetersRecordedBy User?  @relation("StayInitialMetersRecordedBy", fields: [initialMetersRecordedById], references: [id], onDelete: SetNull)

  invoices           Invoice[]
  tickets            Ticket[]
  expenses           Expense[]
  paymentSubmissions PaymentSubmission[]
  renewRequests      RenewRequest[]
  checkoutRequests   CheckoutRequest[]
  depositLedgerEntries TenantDepositLedgerEntry[]

  @@index([tenantId])
  @@index([roomId])
  @@index([status])
  @@index([tenantId, status])
  @@index([roomId, status])
  @@index([checkInDate])
  @@index([expiresAt])
  @@index([bookingSource])
  @@index([stayPurpose])
}

model TenantDepositLedgerEntry {
  id                        Int                            @id @default(autoincrement())
  stayId                    Int
  tenantId                  Int
  roomId                    Int
  type                      TenantDepositLedgerEntryType
  direction                 TenantDepositLedgerDirection
  amountRupiah              Int                            @default(0)
  balanceAfterRupiah        Int                            @default(0)
  depositStatusAfter        DepositStatus?
  depositPaymentStatusAfter BookingDepositPaymentStatus?
  sourceType                String?
  sourceId                  String?
  paymentSubmissionId       Int?
  invoicePaymentId          Int?
  journalEntryId            Int?
  actorUserId               Int?
  occurredAt                DateTime                       @default(now())
  note                      String?
  metadataJson              Json?
  createdAt                 DateTime                       @default(now())

  stay      Stay   @relation(fields: [stayId], references: [id], onDelete: Restrict)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  room      Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actorUser User?  @relation("DepositLedgerActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([stayId])
  @@index([tenantId])
  @@index([roomId])
  @@index([type])
  @@index([direction])
  @@index([occurredAt])
  @@index([sourceType, sourceId])
  @@index([paymentSubmissionId])
}

model MeterReading {
  id           Int         @id @default(autoincrement())
  roomId       Int
  utilityType  UtilityType
  readingAt    DateTime
  readingValue Decimal     @db.Decimal(12, 3)
  note         String?
  recordedById Int?
  createdAt    DateTime    @default(now())

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  recordedBy User? @relation("MeterReadingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([roomId, utilityType, readingAt])
  @@index([roomId, utilityType])
  @@index([readingAt])
}

model Invoice {
  id                Int           @id @default(autoincrement())
  invoiceNumber     String        @unique
  stayId            Int
  status            InvoiceStatus @default(DRAFT)
  periodStart       DateTime      @db.Date
  periodEnd         DateTime      @db.Date
  issuedAt          DateTime?
  dueDate           DateTime?     @db.Date
  paidAt            DateTime?
  totalAmountRupiah Int           @default(0)
  notes             String?
  cancelReason      String?
  createdById       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  stay      Stay  @relation(fields: [stayId], references: [id], onDelete: Restrict)
  createdBy User? @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lines              InvoiceLine[]
  payments           InvoicePayment[]
  paymentSubmissions PaymentSubmission[]

  @@index([stayId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([dueDate])
}

model InvoiceLine {
  id               Int             @id @default(autoincrement())
  invoiceId        Int
  lineType         InvoiceLineType
  utilityType      UtilityType?
  description      String
  qty              Decimal         @default(1) @db.Decimal(12, 2)
  unit             String?
  unitPriceRupiah  Int
  lineAmountRupiah Int
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([lineType])
  @@index([utilityType])
  @@index([invoiceId, sortOrder])
}

model InvoicePayment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int
  paymentDate  DateTime      @db.Date
  amountRupiah Int
  method       PaymentMethod
  referenceNo  String?
  note         String?
  capturedById Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  capturedBy User?   @relation("InvoicePaymentCapturedBy", fields: [capturedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paymentDate])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PaymentSubmission {
  id               Int                         @id @default(autoincrement())
  stayId           Int
  invoiceId        Int?
  tenantId         Int
  submittedById    Int
  amountRupiah     Int
  paidAt           DateTime                    @db.Date
  paymentMethod    PaymentMethod
  targetType       PaymentSubmissionTargetType @default(INVOICE)
  targetId         Int?
  senderName       String?
  senderBankName   String?
  referenceNumber  String?
  notes            String?
  fileKey          String?
  fileUrl          String?
  originalFilename String?
  mimeType         String?
  fileSizeBytes    Int?
  status           PaymentSubmissionStatus     @default(PENDING_REVIEW)
  reviewedById     Int?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  stay        Stay     @relation(fields: [stayId], references: [id], onDelete: Restrict)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submittedBy User     @relation("PaymentSubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?    @relation("PaymentSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([stayId])
  @@index([invoiceId])
  @@index([tenantId])
  @@index([status])
  @@index([invoiceId, status])
  @@index([targetType, status])
  @@index([targetType, targetId])
}

model Ticket {
  id                              Int          @id @default(autoincrement())
  ticketNumber                    String       @unique
  tenantId                        Int?
  roomId                          Int?
  stayId                          Int?
  title                           String
  description                     String
  category                        String?
  issueImageUrl                   String?
  issueImageFileKey               String?
  issueImageOriginalFilename      String?
  issueImageMimeType              String?
  issueImageFileSizeBytes         Int?
  resolutionImageUrl              String?
  resolutionImageFileKey          String?
  resolutionImageOriginalFilename String?
  resolutionImageMimeType         String?
  resolutionImageFileSizeBytes    Int?
  status                          TicketStatus @default(OPEN)
  assignedToId                    Int?
  linkedRoomItemId                Int?
  linkedInventoryItemId           Int?
  finalRoomItemStatus             RoomItemStatus?
  finalInventoryItemStatus        InventoryItemStatus?
  finalAdminNote                  String?
  resolutionNote                  String?
  resolvedAt                      DateTime?
  closedAt                        DateTime?
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt

  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  room       Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  stay       Stay?  @relation(fields: [stayId], references: [id], onDelete: SetNull)
  assignedTo            User?          @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  linkedRoomItem        RoomItem?      @relation("TicketLinkedRoomItem", fields: [linkedRoomItemId], references: [id], onDelete: SetNull)
  linkedInventoryItem   InventoryItem? @relation("TicketLinkedInventoryItem", fields: [linkedInventoryItemId], references: [id], onDelete: SetNull)
  staffFieldReports     StaffFieldReport[]

  @@index([tenantId])
  @@index([roomId])
  @@index([stayId])
  @@index([status])
  @@index([linkedRoomItemId])
  @@index([linkedInventoryItemId])
}

model StaffRoutineTemplate {
  id          Int                   @id @default(autoincrement())
  title       String
  description String?
  frequency   StaffRoutineFrequency @default(DAILY)
  areaType    StaffRoutineAreaType  @default(GENERAL)
  dayOfWeek   Int?
  dayOfMonth  Int?
  requiresPhoto Boolean             @default(false)
  requiresNote  Boolean             @default(false)
  isActive    Boolean               @default(true)
  sortOrder   Int                   @default(0)
  createdById Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  createdBy   User? @relation("StaffRoutineTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments StaffRoutineAssignment[]
  completions StaffRoutineCompletion[]

  @@index([frequency])
  @@index([areaType])
  @@index([isActive, sortOrder])
}

model StaffRoutineAssignment {
  id          Int      @id @default(autoincrement())
  templateId  Int
  staffUserId Int?
  roomId      Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template StaffRoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  staffUser User? @relation("StaffRoutineAssignedTo", fields: [staffUserId], references: [id], onDelete: Cascade)
