# =============================================================================
# KOST48 Surabaya V5 — Konfigurasi Environment Produksi
# Salin file ini sebagai .env (di backend/ atau di cPanel/VPS env vars).
# =============================================================================

# ── Wajib ─────────────────────────────────────────────────────────────────────

# Mode produksi — menonaktifkan Swagger, menyembunyikan stack trace,
#                                            mengetatkan error message, dll.
NODE_ENV=production

# String koneksi PostgreSQL (ganti USER/PASS/HOST/DB_NAME).
# UAT/testing: port 5433, DB kost48_v3_pro
# PRODUKSI: port 5432, DB kost48_v3 (fresh, bukan migrasi dari UAT)
DATABASE_URL="postgresql://USER:PASS@HOST:5432/kost48_v3?schema=public"

# Secret JWT — minimal 32 karakter, acak (generate: `openssl rand -hex 32`).
JWT_SECRET=ganti-dengan-secret-acak-kuat-min-32-char

# CORS — domain frontend (bisa comma-separated untuk multi-domain).
# Dev localhost: http://localhost:5173
# Produksi: https://domainkost48.com
CORS_ORIGIN="https://domainkost48.com"

# ── VAPID (PWA Push Notification) — WAJIB untuk push notification ────────────
# Generate: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=BIlk7MnWqnsprsso3FT5Dwv0uroc7vf-Ty5RPyOBych-2bR8GwcT2jnMpmZrynlppJl2bY_ACTwY1oaH9KUCWts
VAPID_PRIVATE_KEY=isi_dengan_private_key_vapid
VAPID_SUBJECT=mailto:admin@domainkost48.com

# ── Keamanan ─────────────────────────────────────────────────────────────────

# Gate aktivasi kamar: tenant WAJIB upload KTP sebelum kamar jadi OCCUPIED.
# REKOMENDASI: true di produksi (D-07).
KTP_ACTIVATION_GATE_ENABLED=true

# ── Email (Reset Password) ────────────────────────────────────────────────────

# API key dari Brevo (https://www.brevo.com) — opsional.
# Tanpa ini, fitur lupa password tidak bisa kirim email.
BREVO_API_KEY=isi_dengan_api_key_brevo
MAIL_FROM_EMAIL=noreply@domainkost48.com
MAIL_FROM_NAME="Kost48 Surabaya"
FRONTEND_URL=https://domainkost48.com

# ── AI & Market Analysis ──────────────────────────────────────────────────────

# API key dari DeepSeek (https://platform.deepseek.com) — opsional.
# Kosong = fitur Market Analysis & CAC/CLV jalan offline (tanpa AI).
DEEPSEEK_API_KEY=isi_dengan_deepseek_api_key
# Base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model default (default: deepseek-v4-flash, hemat biaya).
# Untuk analisa finance mendalam, pakai DEEPSEEK_FINANCE_MODEL.
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_FINANCE_MODEL=deepseek-v4-pro

# ── AI Fase G (Owner/Admin Approval Copilot) ──────────────────────────────────

# Master toggle AI berbayar. false = semua fitur AI nonaktif / fallback offline.
# AI_FEATURES_ENABLED=false
# AI_MANUAL_ONLY=true            # AI hanya jalan setelah tombol manual (default true)
# AI_OWNER_ADMIN_ONLY=true       # Hanya OWNER/ADMIN bisa pakai AI (default true)
# AI_DAILY_REQUEST_LIMIT=50      # Maks request AI per hari (default 50)
# AI_OWNER_DAILY_REQUEST_LIMIT=30
# AI_ADMIN_DAILY_REQUEST_LIMIT=20
# AI_MAX_INPUT_CHARS=12000       # Maks karakter input per request AI
# AI_MAX_OUTPUT_TOKENS=1400      # Maks token output AI (default)
# AI_FINANCE_MAX_OUTPUT_TOKENS=2200  # Maks token untuk analisa finance (lebih besar)
# AI_LOG_USAGE=true              # Catat usage token di response (default true)

# ── Port ──────────────────────────────────────────────────────────────────────

# PORT (default 3000). cPanel/Passenger biasanya mengatur sendiri.
# VPS: set sesuai kebutuhan.
# PORT=3000

# ── Auto-Ops ──────────────────────────────────────────────────────────────────

# AUTO_OPS_CRON_TOKEN — token opsional untuk trigger HTTP eksternal.
# Kosong = endpoint HTTP dinonaktifkan (hanya auto-ops internal via setInterval).
# AUTO_OPS_CRON_TOKEN=

# AUTO_OPS_ENABLED=true       # Master toggle auto-ops (default true)
# RECURRING_EXPENSE_DRAFTS_ENABLED=true
# ASSET_DEPRECIATION_AUTO_ENABLED=true
# REFERRAL_REWARDS_ENABLED=true
# AC_CLEANING_ENABLED=true
# AC_CLEAN_KWH_THRESHOLD=500   # kWh threshold untuk pemicu dini cuci AC (default 500)
# RENT_RECOGNITION_ENABLED=true
# PUSH_DISPATCH_ENABLED=true
# NOTIFICATION_PRUNING_ENABLED=true
# NOTIFICATION_RETENTION_DAYS=90
# JOURNAL_RECONCILIATION_ENABLED=true
# JOURNAL_RECONCILIATION_LIMIT=50
# AUTO_OPS_INTERVAL_MINUTES=5   # Interval siklus auto-ops (default 5 menit)

# ── Akuntansi ─────────────────────────────────────────────────────────────────

# Auto-close periode akuntansi (default true).
# ACCOUNTING_AUTO_CLOSE_ENABLED=true

# ── Loyalty Points ────────────────────────────────────────────────────────────

# Nilai poin (env-override, default dari dossier 19).
# LOYALTY_POINTS_RENEWAL=100
# LOYALTY_POINTS_ON_TIME_PAYMENT=50
# LOYALTY_POINTS_VALIDATED_REPORT=30
# LOYALTY_POINTS_ONBOARDING_QUEST=200
# LOYALTY_POINTS_PEER_IMPROVEMENT=40
# LOYALTY_POINTS_REFERRAL=150
# LOYALTY_POINT_RUPIAH_VALUE=100   # Estimasi nilai rupiah per poin

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Global: maks 300 request/menit/IP (longgar).
# RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Auth: maks 10 percobaan login/forgot/reset per 15 menit/IP.
# RATE_LIMIT_AUTH_PER_15MIN=10

# ── Deadline Auto-Ops (env-override, default sudah optimal) ──────────────────

# BOOKING_REVIEW_DEADLINE_HOURS=3
# APPROVED_BOOKING_PAYMENT_DEADLINE_HOURS=3
# PAYMENT_REVIEW_URGENT_HOURS=1
# PAYMENT_REVIEW_ESCALATE_HOURS=3
# PAYMENT_REVIEW_MAX_HOURS=6
# INVOICE_URGENT_AFTER_HOURS=6
# INVOICE_DUE_AFTER_HOURS=24
# RENEW_REMINDER_DAYS=3
# RENEW_LAST_CALL_HOURS=24
# RENEW_PAYMENT_DEADLINE_HOURS=3
# RENEW_REVIEW_URGENT_HOURS=3
# RENEW_REVIEW_ESCALATE_HOURS=6
# CHECKOUT_REVIEW_URGENT_HOURS=3
# CHECKOUT_REVIEW_ESCALATE_HOURS=6
# CHECKOUT_FINAL_URGENT_HOURS=6
# LATE_TENANT_VACATE_HOURS=3

# ── Lain-lain ─────────────────────────────────────────────────────────────────

# AI_PROVIDER_KEY (alternatif fallback DeepSeek key, tidak dipakai bila DEEPSEEK_API_KEY terisi)
# AI_PROVIDER_KEY=
