# =============================================================================
# KOST48 Surabaya V5 — Environment Produksi (MINIMAL)
# Salin sebagai `.env`. Sebagian besar pengaturan kini owner-settable via
# UI Owner → Pengaturan (tersimpan di DB), jadi .env cukup berisi yang esensial.
# =============================================================================

# ── Wajib (startup) ─────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL="postgresql://USER:PASS@HOST:5432/kost48_v3?schema=public"
JWT_SECRET=ganti-dengan-secret-acak-kuat-min-32-char
CORS_ORIGIN="https://domainkost48.com"
FRONTEND_URL=https://domainkost48.com

# ── Gate & Landing ──────────────────────────────────────────────────────────
# Gate aktivasi KTP (nilai AWAL row settings; sesudahnya via UI Settings → Operasional)
KTP_ACTIVATION_GATE_ENABLED=true
# Landing page: false = booking online ditutup (arahkan ke WhatsApp)
PUBLIC_ONLINE_BOOKING_ENABLED=false
# PIN wizard status kamar (klik versi footer 10x) — env-only, minimal 6 karakter
AVAILABILITY_OWNER_PIN=ganti-dengan-pin-panjang-acak

# ── Auto-ops ────────────────────────────────────────────────────────────────
# VPS/always-on -> true. Shared hosting/Passenger (idle-sleep) -> false + cron.
AUTO_OPS_ENABLED=false
AUTO_OPS_CRON_TOKEN="ganti-token-cron-acak-panjang"

# ── Semua API key lain = owner-settable via UI Owner → Pengaturan (DB) ──────
# DeepSeek AI · Brevo email · Tuya IoT · Web Push VAPID TIDAK perlu di .env —
# isi via UI Owner → Pengaturan setelah login. Env di bawah hanya fallback:
#   DEEPSEEK_API_KEY=...
#   BREVO_API_KEY=...
#   TUYA_ACCESS_KEY=...   TUYA_SECRET_KEY=...   TUYA_API_BASE=...
#   VAPID_PUBLIC_KEY=...  VAPID_PRIVATE_KEY=...  VAPID_SUBJECT=...
#   IOT_MASTER_KEY=...    (32-byte base64, JANGAN diubah antar-deploy — enkripsi ESP32)
