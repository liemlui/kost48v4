# =============================================================================
# Contoh konfigurasi backend KOST48 - SEMUA NILAI SENGAJA KOSONG.
# Salin ke `.env` lalu isi di mesin/server Anda. JANGAN mengisi berkas ini.
#
# Asal-usul daftar kunci: dipanen dari kode pada 2026-09-24 dengan pola
#   process.env.X | process.env['X'] | configService.get('X')
# atas backend/src/** dan backend/prisma/**. Kunci yang disediakan library/OS
# dikelompokkan terpisah di bagian 12 dan TIDAK perlu diisi.
#
# Rumah kanonik cara pakai & nilai produksi (jangan diduplikasi di sini):
#   docs/OPERASI.md - docs/operations/deploy-go-live.md - docs/operations/go-live-cpanel.md
#   docs/operations/default-dev.md (nilai DEV) - docs/operations/produksi.md (produksi)
#
# Nilai default yang aman biasanya ditulis di kode dengan pola `process.env.X || '<default>'`;
# kunci tanpa default wajib diisi. Kelengkapan daftar: lihat catatan batas di akhir berkas.
# =============================================================================

# --- 1. Inti runtime ---------------------------------------------------------
NODE_ENV=
PORT=
FRONTEND_URL=
# Domain frontend yang diizinkan (backend menolak start bila kosong di produksi).
CORS_ORIGIN=
# Lokasi berkas hasil build frontend yang disajikan backend (opsional).
FRONTEND_DIST_PATH=
DEBUG=

# --- 2. Database -------------------------------------------------------------
# RAHASIA (berisi kredensial). Postgres; di cPanel gunakan koneksi yang disediakan hosting.
DATABASE_URL=

# --- 3. Autentikasi & pembatasan laju ---------------------------------------
# RAHASIA. Wajib diganti; jangan pakai nilai DEV di produksi.
JWT_SECRET=
JWT_EXPIRES_IN=
RATE_LIMIT_AUTH_PER_15MIN=
RATE_LIMIT_GLOBAL_PER_MINUTE=
# PIN akses halaman ketersediaan OWNER. RAHASIA.
AVAILABILITY_OWNER_PIN=
# Gerbang KTP produksi: default OFF di kode, wajib ON sebelum onboarding nyata.
KTP_ACTIVATION_GATE_ENABLED=

# --- 4. Email transaksional (Brevo) -----------------------------------------
# RAHASIA (kunci API).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# --- 5. AI owner/admin (DeepSeek) -------------------------------------------
# RAHASIA. Isi salah satu sesuai provider yang dipakai.
AI_PROVIDER_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_FINANCE_MODEL=
AI_FEATURES_ENABLED=
AI_OWNER_ADMIN_ONLY=
AI_MANUAL_ONLY=
AI_LOG_USAGE=
AI_DAILY_REQUEST_LIMIT=
AI_MAX_INPUT_CHARS=
AI_MAX_OUTPUT_TOKENS=
AI_FINANCE_MAX_OUTPUT_TOKENS=
AI_DRAFT_RETENTION_DAYS=

# --- 6. Web Push / PWA (VAPID) ----------------------------------------------
# Tanpa ketiga kunci ini push otomatis NONAKTIF (notifikasi in-app tetap jalan).
VAPID_PUBLIC_KEY=
# RAHASIA.
VAPID_PRIVATE_KEY=
# Format mailto:owner@domain
VAPID_SUBJECT=
PUSH_DISPATCH_ENABLED=

# --- 7. IoT (Tuya) & meter ---------------------------------------------------
# RAHASIA. Pengembangan IoT ditunda, tetapi pencatatan meter untuk tagihan tetap dipakai.
IOT_MASTER_KEY=
IOT_TUYA_POLL_ENABLED=
IOT_TUYA_POLL_MINUTES=
# RAHASIA (token endpoint cron IoT).
IOT_TUYA_CRON_TOKEN=
IOT_STALE_AFTER_MINUTES=
# RAHASIA (kredensial Tuya Cloud).
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_API_BASE=
AC_CLEANING_ENABLED=
AC_CLEAN_KWH_THRESHOLD=

# --- 8. Auto-ops, cron, dan telemetri ---------------------------------------
# VPS/always-on: true + interval. Shared hosting/Passenger: false + token + cPanel Cron.
AUTO_OPS_ENABLED=
AUTO_OPS_INTERVAL_MINUTES=
# RAHASIA (header X-Cron-Token pada GET /api/auto-ops/cron).
AUTO_OPS_CRON_TOKEN=
NOTIFICATION_PRUNING_ENABLED=
NOTIFICATION_RETENTION_DAYS=
MEMORY_TELEMETRY_ENABLED=
MEMORY_TELEMETRY_INTERVAL_SECONDS=
ADMIN_DASHBOARD_CACHE_MS=

# --- 9. Buku besar, akuntansi, dan aset -------------------------------------
ACCOUNTING_AUTO_CLOSE_ENABLED=
ASSET_DEPRECIATION_AUTO_ENABLED=
RENT_RECOGNITION_ENABLED=
RECURRING_EXPENSE_DRAFTS_ENABLED=
JOURNAL_RECONCILIATION_ENABLED=
JOURNAL_RECONCILIATION_LIMIT=

# --- 10. Booking, tagihan, perpanjangan, checkout (batas waktu, dalam jam/hari) ---
PUBLIC_ONLINE_BOOKING_ENABLED=
APPROVED_BOOKING_PAYMENT_DEADLINE_HOURS=
BOOKING_REVIEW_DEADLINE_HOURS=
INVOICE_DUE_AFTER_HOURS=
INVOICE_URGENT_AFTER_HOURS=
PAYMENT_REVIEW_MAX_HOURS=
PAYMENT_REVIEW_URGENT_HOURS=
PAYMENT_REVIEW_ESCALATE_HOURS=
RENEW_REMINDER_DAYS=
RENEW_LAST_CALL_HOURS=
RENEW_PAYMENT_DEADLINE_HOURS=
RENEW_REVIEW_URGENT_HOURS=
RENEW_REVIEW_ESCALATE_HOURS=
CHECKOUT_REVIEW_URGENT_HOURS=
CHECKOUT_REVIEW_ESCALATE_HOURS=
CHECKOUT_FINAL_URGENT_HOURS=
LATE_TENANT_VACATE_HOURS=

# --- 11. Loyalitas & referral ------------------------------------------------
LOYALTY_POINT_RUPIAH_VALUE=
LOYALTY_POINTS_ONBOARDING_QUEST=
LOYALTY_POINTS_ON_TIME_PAYMENT=
LOYALTY_POINTS_REFERRAL=
LOYALTY_POINTS_RENEWAL=
LOYALTY_POINTS_PEER_IMPROVEMENT=
LOYALTY_POINTS_VALIDATED_REPORT=
REFERRAL_REWARDS_ENABLED=

# --- 12. Disediakan library/OS - JANGAN diisi manual -------------------------
# Kunci berikut terdeteksi dari kode tetapi ditulis/dibaca oleh Prisma, dotenv, atau OS.
# Dibiarkan di sini hanya sebagai penjelas agar tidak dikira konfigurasi aplikasi.
# PRISMA_CLIENT_DATA_PROXY_CLIENT_VERSION, PRISMA_CLIENT_ENGINE_TYPE, PRISMA_CLIENT_GET_TIME,
# PRISMA_DISABLE_WARNINGS, PRISMA_QUERY_ENGINE_BINARY, PRISMA_QUERY_ENGINE_LIBRARY,
# DOTENV_CONFIG_DEBUG, DOTENV_KEY, TEST_CLIENT_ENGINE_REMOTE_EXECUTOR,
# COMPUTERNAME, NO_COLOR

# =============================================================================
# BATAS BERKAS INI (jujur, jangan dianggap kontrak lengkap):
# - Kelengkapan hanya sejauh tiga pola panen di atas. Kunci yang dibaca dengan cara lain
#   (mis. objek konfigurasi bersarang) TIDAK terjamin tertangkap.
# - "RAHASIA" ditandai dari nama kunci, bukan dari verifikasi kode.
# - Wajib/opsional tidak diklaim di sini: rujuk default di kode dan runbook di docs/operations/.
# - Berkas ini tidak dibaca aplikasi (dotenv membaca `.env`), jadi mengubahnya tidak mengubah runtime.
# =============================================================================
