# Tuya Cloud project (server-side only; never expose in VITE_* variables)
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
TUYA_API_BASE=https://openapi.tuyaus.com

# 32 random bytes, base64 or 64 hex chars. Used only to encrypt ESP32 secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IOT_MASTER_KEY=

# Dashboard considers a device stale after this many minutes.
IOT_STALE_AFTER_MINUTES=30
