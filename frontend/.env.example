VITE_API_BASE_URL=http://localhost:3000/api

# ── Kredensial AUDIT e2e (AO-03) ──────────────────────────────────────────
# Dibaca langsung oleh Playwright (frontend/e2e/*) dari env proses/shell.
# TIDAK ada password real di file ini — hanya nama variable.
# Penyediaan akun audit di UAT: backend `npm run seed:audit-users` (izin owner).
