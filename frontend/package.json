{
  "name": "kost48surabaya-v3-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-pwa-build.mjs && node scripts/verify-pwa.mjs",
    "pwa:stamp": "node scripts/stamp-pwa-build.mjs",
    "pwa:verify": "node scripts/verify-pwa.mjs",
    "preview": "vite preview",
    "build:lan": "node scripts/golive-build.mjs",
    "golive": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:a11y": "npx playwright test e2e/a11y/"
  },
  "dependencies": {
